	"Sketch": {
		"scope": "typescript",
		"prefix": "sketch",
		"body": [
			"import GUI from \"lil-gui\"",
			"import type p5 from \"p5\"",
			"",
			"export default (p: p5) => {",
			"\tconst config = {",
			"\t\tcircleSize: 80,",
			"\t\tfillColor: \"#FFFFFF\",",
			"\t\tstrokeColor: \"#000000\",",
			"\t}",
			"\tp.setup = () => {",
			"\t\tp.createCanvas(800, 800, p.WEBGL)",
			"\t\tp.background(220)",
			"",
			"\t\tconst gui = new GUI()",
			"\t\tgui.add(config, \"circleSize\", 40, 120, 1)",
			"\t\tgui.addColor(config, \"fillColor\")",
			"\t\tgui.addColor(config, \"strokeColor\")",
			"\t}",
			"\tp.draw = () => {",
			"\t\tconst mx = p.mouseX - p.width / 2",
			"\t\tconst my = p.mouseY - p.height / 2",
			"\t\tif (p.mouseIsPressed) {",
			"\t\t\tp.fill(config.fillColor)",
			"\t\t\tp.stroke(config.strokeColor)",
			"\t\t\tp.circle(mx, my, config.circleSize)",
			"\t\t}",
			"\t}",
			"}",
			""
		]
	}
}
